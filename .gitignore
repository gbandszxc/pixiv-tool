# ============================================================
# pixiv-tool .gitignore
# 技术栈：Tauri 2（Rust）+ Vue3 + Vite + pnpm
# 平台：Windows / macOS / Linux
# ============================================================

# ===== Rust / Tauri =====
src-tauri/target/
# tauri-build 每次构建重新生成的 schema
src-tauri/gen/schemas/

# ===== Node / Vue / Vite =====
node_modules/
.pnp
.pnp.js
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.local
dist-ssr/

# ===== 编辑器 / IDE =====
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/
*.swp
*.swo
*~
.history/
.fleet/

# ===== 操作系统 =====
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
.DS_Store
.AppleDouble
.LSOverride
# 注意：不要写 `Icon?`，macOS 大小写不敏感会误伤 src-tauri/icons/
.Trash-*

# ====================================================================
# ===== 项目特定：用户数据（绝不入库）                                =====
# ====================================================================

# --- SQLite 数据库（任务进度、去重表、运行时数据） ---
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# --- 用户配置（含个人输出目录路径等，每机不同） ---
config/settings.json
config/login-browser-profile/

# --- 运行日志 ---
data/logs/
*.log

# ===== Spike 运行产物（不入库） =====
spike/**/result.json
spike/**/cookie_inspect.json

# ===== 通用 =====
.env
.env.local
.env.*.local
*.tmp
*.bak
*.orig
tmp/
temp/
downloads/
.scratch/build-*

# ===== AI 辅助工具会话产物（本地规划文档，不入库） =====
.zcode/

# --- 前端构建产物（tauri build 自动生成） ---
frontend/dist/
