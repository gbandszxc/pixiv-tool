# ============================================================
# pixiv-tool .gitattributes
# 统一换行符策略，避免 Windows/macOS/Linux 协作时的 diff 抖动
# ============================================================

# 默认：所有文本文件入库时强制 LF（git 内部存储用 LF）
* text=auto eol=lf

# 显式文本类型
*.md       text eol=lf
*.py       text eol=lf
*.ts       text eol=lf
*.tsx      text eol=lf
*.js       text eol=lf
*.jsx      text eol=lf
*.vue      text eol=lf
*.json     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.toml     text eol=lf
*.css      text eol=lf
*.html     text eol=lf
*.sh       text eol=lf
*.spec     text eol=lf
.gitignore text eol=lf
.editorconfig text eol=lf

# Windows 专用脚本：保持 CRLF（PowerShell 对 CRLF 更友好）
*.ps1      text eol=crlf
*.bat      text eol=crlf
*.cmd      text eol=crlf

# 二进制文件：不做换行符转换
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.icns     binary
*.pdf      binary
*.zip      binary
*.gz       binary
*.tgz      binary
*.7z       binary
*.db       binary
*.dat      binary
*.exe      binary
*.dll      binary
*.so       binary
*.dylib    binary
