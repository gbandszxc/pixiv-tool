{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pixiv Tool",
  "version": "1.2.2",
  "identifier": "com.pixivtool.desktop",
  "build": {
    "devUrl": "http://localhost:9961",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pixiv Tool",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' https: data: blob: pixiv-img: pixiv-avatar: http://pixiv-img.localhost http://pixiv-avatar.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' https: data: blob: pixiv-img: pixiv-avatar: http://pixiv-img.localhost http://pixiv-avatar.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost ws://localhost:9961 ws://127.0.0.1:9961",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
